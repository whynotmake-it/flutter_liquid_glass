import 'package:flutter/widgets.dart';
import 'package:liquid_glass_renderer/liquid_glass_renderer.dart';
import 'package:liquid_glass_renderer/rendering.dart';

const shape = LiquidRoundedSuperellipse(radius: 20);
final key = BackdropKey();

void debugGeometry() {
  debugPaintLiquidGlassGeometry = true;
}

LiquidGlassSettings settings(BuildContext context) =>
    LiquidGlassLayer.settingsOf(context);

Widget backdropGroups() {
  return LiquidGlassLayer(
    child: Column(
      children: [
        LiquidGlass.auto(
          shape: shape,
          child: const SizedBox(),
        ),
        LiquidGlass.withOwnLayer(
          shape: shape,
          child: const SizedBox(),
        ),
        FakeGlass(shape: shape, child: const SizedBox()),
      ],
    ),
  );
}

LiquidGlassSettings slider(LiquidGlassSettings base) {
  final light = LiquidGlassSettings.ios27Regular(brightness: Brightness.light, sliderPosition: 0.5);
  final dark = LiquidGlassSettings.ios27Regular(brightness: Brightness.dark);
  final regular = LiquidGlassSettings.ios27Regular(
    brightness: Brightness.dark,
    sliderPosition: 1,
  );
  final clear = LiquidGlassSettings.ios27Clear(sliderPosition: 0.25);
  const plain = LiquidGlassSettings(sliderPosition: 0.5, glintStrength: 0.4);
  return base.copyWith(
    sliderPosition: light.sliderPosition + dark.sliderPosition + clear.sliderPosition,
    glintStrength: regular.glintStrength + plain.glintStrength,
  );
}

List<LiquidGlassAppearance> appearances() => [
  LiquidGlassAppearance.ios27Regular(brightness: Brightness.light),
  LiquidGlassAppearance.ios27Regular(brightness: Brightness.dark, tint: const Color(0xFF0A84FF)),
  const LiquidGlassAppearance(
    colorModel: LiquidGlassColorModel.ios27Regular(brightness: Brightness.light),
  ),
];

List<LiquidShape> shapes(LiquidRoundedRectangle box) => [
  LiquidRoundedSuperellipse(radius: 20),
  LiquidRoundedRectangle(radius: 8),
  box.copyWith(radius: 4),
];

Future<void> warm() async {
  await precacheLiquidGlass();
  await Future.wait([precacheLiquidGlass()]).then((_) => precacheLiquidGlass);
}

Widget blended() => LiquidGlassBlendGroup(
  child: Row(
    children: [
      LiquidGlass(shape: shape, child: const SizedBox()),
      LiquidGlass(shape: const LiquidOval(), child: const SizedBox()),
    ],
  ),
);
