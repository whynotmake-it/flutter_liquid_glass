!ios/Runner/
ios/Runner/*
!ios/Runner/Info.plist
!tool/apple_match/flutter/ios/
!tool/apple_match/flutter/ios/**
android/*
!android/app/
android/app/*
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
windows/
linux/
web/

